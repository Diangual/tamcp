PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=120d
FRONTEND_URL=https://tamcp.org

# Email (Gmail SMTP)
GMAIL_USER=votre_email@gmail.com
GMAIL_APP_PASSWORD=votre_mot_de_passe_d_application
NOTIFICATION_TEST_EMAIL=destinataire_test@gmail.com

# Base de données PostgreSQL
DB_USER=tamcp
DB_PASSWORD=tamcp_secure_password
DB_HOST=db
DB_PORT=5432
DB_NAME=tamcp
# Ou bien utiliser DATABASE_URL directement :
# DATABASE_URL=postgresql://tamcp:tamcp_secure_password@db:5432/tamcp
