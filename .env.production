# tamcp-backend environment variables
NODE_ENV=production
PORT=5000

# Database
DB_HOST=db
DB_PORT=5432
DB_USER=tamcp
DB_PASSWORD=tamcp_secure_password
DB_NAME=tamcp

# Authentication (Change this in actual production!)
JWT_SECRET=super_secret_tamcp_jwt_token_key_change_me
JWT_EXPIRES_IN=7d

# Frontend API URL (Nginx proxies /api to backend:5000/api)
VITE_API_URL=/api
